<Window x:Class="FinanzApp.View.TransactionDetail"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FinanzApp.View"
        xmlns:enums="clr-namespace:FinanzApp.core.Infrastructure;assembly=FinanzApp.core"
        xmlns:system="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Background="LightBlue"
        Title="Transaktion Details"
        Height="450"
        Width="800"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0"
                    Margin="10">

            <!--Name-->
            <TextBlock FontSize="16"
                       Text="Name" />
            <TextBox Text="{Binding Transaction.Name, UpdateSourceTrigger=PropertyChanged}"
                     HorizontalAlignment="Left"
                     Height="30"
                     Width="250"
                     Margin="0 5 0 15"
                     FontSize="16" />

            <!--Description-->
            <TextBlock FontSize="16"
                       Text="Description" />
            <TextBox Text="{Binding Transaction.Description, UpdateSourceTrigger=PropertyChanged}"
                     HorizontalAlignment="Left"
                     Height="30"
                     Width="250"
                     Margin="0 5 0 15"
                     MaxLines="2" />

            <!--Date-->
            <TextBlock FontSize="16"
                       Text="Date" />
            <TextBox Text="{Binding Transaction.Date, UpdateSourceTrigger=PropertyChanged}"
                     HorizontalAlignment="Left"
                     Height="30"
                     Width="250"
                     Margin="0 5 0 15" 
                     FontSize="16"/>

            <!--Category-->
            <TextBlock FontSize="16"
                       Text="Category" />
            <TextBox Text="{Binding Transaction.Category, UpdateSourceTrigger=PropertyChanged}"
                     HorizontalAlignment="Left"
                     Height="30"
                     Width="250"
                     Margin="0 5 0 15"
                     FontSize="16" />

        </StackPanel>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Margin="10">

                <!--Amount-->
                <TextBlock FontSize="16"
                           Text="Amount" />
                <TextBox Text="{Binding Transaction.Amount, UpdateSourceTrigger=PropertyChanged}"
                         HorizontalAlignment="Left"
                         Height="30"
                         Width="250"
                         Margin="0 5 0 15"
                         FontSize="16"/>

                <!--Amount-Type-->
                <TextBlock FontSize="16"
                           Text="Amount-Type" />
                <ComboBox ItemsSource="{Binding TransactionTypeList}"
                          SelectedItem="{Binding Transaction.TransactionType, Mode=TwoWay}"
                          HorizontalAlignment="Left"
                          Width="250"
                          Height="30"
                          Margin="0 5 0 15"
                          FontSize="16" />

                <!--Budget Amount-->
                <TextBlock FontSize="16"
                           Text="Budget Amount" />
                <TextBox Text="{Binding Transaction.BudgetAmount, UpdateSourceTrigger=PropertyChanged}"
                         HorizontalAlignment="Left"
                         Height="30"
                         Width="250"
                         Margin="0 5 0 15"
                         FontSize="16"/>
            </StackPanel>

            <StackPanel Grid.Row="1"
                        Orientation="Horizontal">

                <Button Grid.Column="1"
                        Grid.Row="1"
                        Content="Speichern"
                        FontSize="16"
                        Width="150"
                        Height="50"
                        Margin="30"
                        Command="{Binding SaveCommand}" />

                <Button Grid.Column="1"
                        Grid.Row="1"
                        Content="Abbrechen"
                        FontSize="16"
                        Width="150"
                        Height="50"
                        Margin="30"
                        Command="{Binding CancelCommand}" />
            </StackPanel>

        </Grid>
    </Grid>
</Window>
