<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:convert="clr-namespace:FinanzApp.Converters"
                    xmlns:core="clr-namespace:FinanzApp.core.Models;assembly=FinanzApp.core">

    <convert:NegateAmountConverter x:Key="NegateAmountConverter" />
    <convert:SumAmountConverter x:Key="SumAmountConverter" />

    <DataTemplate x:Key="FinanceRowTemplate">
        <Grid Margin="0,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="{Binding Name}"
                       Margin="10,6,8,6"
                       FontSize="20"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Left" />

            <TextBlock Grid.Column="1"
                       Text="{Binding Amount, StringFormat={}{0:C}}"
                       Margin="10, 6, 8, 6"
                       FontSize="20"
                       VerticalAlignment="Center"
                       TextAlignment="Right"
                       FontWeight="Bold"
                       HorizontalAlignment="Stretch">

                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Text"
                                Value="{Binding Amount, StringFormat={}{0:C}}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding TransactionType}"
                                         Value="{x:Static core:TransactionType.Expense}">
                                <Setter Property="Text"
                                        Value="{Binding Amount, Converter={StaticResource NegateAmountConverter}, StringFormat={}{0:C}}" />
                                <Setter Property="Foreground"
                                        Value="IndianRed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
    </DataTemplate>

    <ControlTemplate x:Key="ExpanderGroupTemplate"
                     TargetType="{x:Type GroupItem}">
        <Expander IsExpanded="False"
                  Margin="0,6,0,0">
            <Expander.Header>
                <DockPanel>
                    <TextBlock Text="{Binding Name}"
                               FontWeight="Bold" />
                    <TextBlock DockPanel.Dock="Right"
                               Text="{Binding Items, Converter={StaticResource SumAmountConverter}, StringFormat={}{0:C}}"
                               FontWeight="SemiBold" />
                </DockPanel>
            </Expander.Header>
        </Expander>
    </ControlTemplate>

    <ControlTemplate x:Key="FlatGroupTemplate"
                     TargetType="{x:Type GroupItem}">
        <ItemsPresenter Margin="0" />
    </ControlTemplate>

    <Style x:Key="CategoryGroupItemStyle"
           TargetType="{x:Type GroupItem}">
        <Setter Property="Template"
                Value="{StaticResource ExpanderGroupTemplate}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Name}"
                         Value="">
                <Setter Property="Template"
                        Value="{StaticResource FlatGroupTemplate}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Name}"
                         Value="{x:Null}">
                <Setter Property="Template"
                        Value="{StaticResource FlatGroupTemplate}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--<GroupStyle x:Key="CategoryGroupStyle">
        <GroupStyle.ContainerStyle>
            <Style BasedOn="{StaticResource CategoryGroupItemStyle}"
                   TargetType="{x:Type GroupItem}" />
        </GroupStyle.ContainerStyle>
        <GroupStyle.Panel>
            <ItemsPanelTemplate>
                <StackPanel />
            </ItemsPanelTemplate>
        </GroupStyle.Panel>
    </GroupStyle>-->

    <GroupStyle x:Key="CategoryGroupStyle">
        <GroupStyle.ContainerStyle>
            <Style TargetType="{x:Type GroupItem}">
                <!-- Standard: Expander + Header -->
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type GroupItem}">
                            <Expander IsExpanded="True">
                                <Expander.Header>
                                    <Grid Margin="6,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <!-- Gruppenname -->
                                        <TextBlock Text="{Binding Name}"
                                                   VerticalAlignment="Center" />
                                        <!-- Summe rechts -->
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Converter={StaticResource SumAmountConverter}, StringFormat={}{0:C}}"
                                                   HorizontalAlignment="Right"
                                                   TextAlignment="Right"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </Expander.Header>
                                <ItemsPresenter />
                            </Expander>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>

                <!-- Für 'Ohne Kategorie': KEIN Header, KEIN Expander -->
                <Style.Triggers>
                    <!-- Wenn du einen Label-Converter verwendest: -->
                    <DataTrigger Binding="{Binding Name}"
                                 Value="Ohne Kategorie">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type GroupItem}">
                                    <ItemsPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </DataTrigger>

                    <!-- Falls du KEIN Label setzt und Name null ist:
        <DataTrigger Binding="{Binding Name}" Value="{x:Null}">
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="{x:Type GroupItem}">
                <ItemsPresenter/>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </DataTrigger>
        -->
                </Style.Triggers>
            </Style>
        </GroupStyle.ContainerStyle>
    </GroupStyle>

</ResourceDictionary>